rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(hid) {
      return exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }

    function validText(value) {
      return value is string && value.size() > 0 && value.size() <= 100 && !value.matches('.*[<>{}"].*');
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Codes are document ids, so a joiner can only read a code they already know. Listing is denied.
    // Any signed-in user may get a code they know: joining needs the invite document (its householdId and expiry)
    // before the user is a member. Signed-out reads are refused. Codes are random and short-lived, so this is accepted.
    // createdAt is the server time of the write, and an invite lives at most 7 days plus a 5 minute clock skew allowance
    // (a device clock slightly ahead must not make the client's 7-day expiry fail).
    // The code id is 8 characters from the client's alphabet (no I, O, 0 or 1), the same format as utils/inviteCode.ts.
    // Only the four fields the client writes are allowed, so an invite cannot carry extra data.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['householdId', 'createdBy', 'createdAt', 'expiresAt'])
        && request.resource.data.createdBy == request.auth.uid
        && isMember(request.resource.data.householdId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd') + duration.value(5, 'm');
      allow delete: if signedIn() && isMember(resource.data.householdId);
    }

    match /households/{hid} {
      allow get: if signedIn() && isMember(hid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && validText(request.resource.data.name);
      allow update, delete: if false;

      match /members/{uid} {
        // Self-read is needed so a joiner can check for an existing membership inside the join transaction.
        allow read: if signedIn() && (request.auth.uid == uid || isMember(hid));
        // Owner bootstrap: the household does not exist yet, so the owner doc is created in the same batch.
        // Joiners: must present an unexpired invite for this household.
        allow create: if signedIn()
          && request.auth.uid == uid
          && (
            (request.resource.data.role == 'owner' && !exists(/databases/$(database)/documents/households/$(hid)))
            || (
              request.resource.data.role == 'member'
              && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.householdId == hid
              && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.expiresAt > request.time
            )
          );
        allow update, delete: if false;
      }

      // Items: the client sends only these keys. Items are created by their owner, so createdBy is checked on create.
      match /groceries/{id} {
        function validItem() {
          return request.resource.data.keys().hasOnly(['name', 'category', 'completed', 'createdBy', 'createdAt'])
            && validText(request.resource.data.name)
            && validText(request.resource.data.category)
            && request.resource.data.completed is bool;
        }

        allow read, delete: if signedIn() && isMember(hid);
        allow create: if signedIn()
          && isMember(hid)
          && request.resource.data.createdBy == request.auth.uid
          && validItem();
        allow update: if signedIn()
          && isMember(hid)
          && request.resource.data.createdBy == resource.data.createdBy
          && validItem();
      }

      // Recipes: members create and read their household's recipes. No edits in this version.
      // Rules cannot loop over list items, so per-item lengths and blocked characters in ingredients and steps
      // are checked only in services/recipeService.ts. Titles are checked here.
      match /recipes/{id} {
        allow read, delete: if signedIn() && isMember(hid);
        allow create: if signedIn()
          && isMember(hid)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is timestamp
          && request.resource.data.keys().hasOnly(['title', 'time', 'category', 'label', 'ingredients', 'steps', 'image', 'createdAt', 'createdBy'])
          && validText(request.resource.data.title)
          && request.resource.data.time is string
          && request.resource.data.time.size() <= 50
          && !request.resource.data.time.matches('.*[<>{}"].*')
          && request.resource.data.category in ['Breakfast', 'Lunch', 'Dinner', 'Drinks', 'Snacks', 'Desserts']
          && request.resource.data.label in ['Summer Fresh ☀️', 'Cozy Winter ❄️', 'Quick & Easy ⚡', 'Comfort Food 🥣']
          && request.resource.data.ingredients is list
          && request.resource.data.ingredients.size() <= 50
          && request.resource.data.steps is list
          && request.resource.data.steps.size() <= 50
          && request.resource.data.image is string
          && request.resource.data.image.size() <= 2048
          && (request.resource.data.image == '' || request.resource.data.image.matches('households/' + hid + '/recipes/[A-Za-z0-9-]+[.]webp'));
        allow update: if false;
      }

      // Weekly menu: one document per day (YYYY-MM-DD) with a lunch and a dinner entry.
      // Days are never deleted by the app. Recipe links are plain ids, checked here and by the service.
      match /menu/{date} {
        function validMeal(meal) {
          return meal is map
            && meal.keys().hasOnly(['main', 'side', 'mainRecipeId', 'sideRecipeId'])
            && meal.main is string && meal.main.size() <= 100 && !meal.main.matches('.*[<>{}"].*')
            && meal.side is string && meal.side.size() <= 100 && !meal.side.matches('.*[<>{}"].*')
            && meal.mainRecipeId is string && (meal.mainRecipeId == '' || (meal.main != '' && meal.mainRecipeId.matches('[A-Za-z0-9_-]{1,128}')))
            && meal.sideRecipeId is string && (meal.sideRecipeId == '' || (meal.side != '' && meal.sideRecipeId.matches('[A-Za-z0-9_-]{1,128}')));
        }

        allow read: if signedIn() && isMember(hid);
        allow create, update: if signedIn()
          && isMember(hid)
          // Month lengths are checked here. February allows 29 days in any year: the rules cannot tell leap years,
          // so the service rejects a 29 February that is not real.
          && date.matches('[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-9]))')
          && request.resource.data.keys().hasOnly(['lunch', 'dinner'])
          && (!('lunch' in request.resource.data) || validMeal(request.resource.data.lunch))
          && (!('dinner' in request.resource.data) || validMeal(request.resource.data.dinner));
        allow delete: if false;
      }

      // The category map is written once, when the household is created. Members can read it; no client edits it.
      match /configuration/{doc} {
        allow read: if signedIn() && isMember(hid);
        allow create: if signedIn()
          && doc == 'categoryMap'
          && request.resource.data.keys().hasOnly(['map'])
          // Owner bootstrap: the household and member doc are created in the same transaction,
          // so membership cannot be checked yet. Only allowed while the household does not exist.
          && !exists(/databases/$(database)/documents/households/$(hid));
        allow delete: if false;
      }
    }
  }
}

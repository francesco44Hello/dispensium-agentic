{
  "name": "dispensium-agentic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:e2e": "playwright test --project=mobile",
    "test:visual": "playwright test --project=visual",
    "test:rules": "firebase emulators:exec --only firestore --project demo-dispensium \"vitest run -c vitest.rules.config.js\"",
    "audit": "npm audit --omit=dev --audit-level=critical",
    "audit:full": "npm audit --audit-level=high"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "firebase": "^13.0.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^29.1.1",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}

{
  "name": "dispensium-agentic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:e2e": "playwright test --project=mobile",
    "test:visual": "playwright test --project=visual",
    "test:rules": "firebase emulators:exec --only firestore --project demo-dispensium \"vitest run -c vitest.rules.config.js\"",
    "audit": "npm audit --omit=dev --audit-level=critical",
    "audit:full": "npm audit --audit-level=high",
    "verify:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && npm run verify"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "firebase": "^13.0.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
